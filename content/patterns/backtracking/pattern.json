      "id": "choose-or-skip",
      "name": "Choose or skip",
      "summary": "For each item, branch on taking it or leaving it.",
      "requires": "Every candidate is a selection of items, in a fixed order."
    },
    {
      "id": "arrange",
      "name": "Arrange in order",
      "summary": "Fill one position at a time with any unused item.",
      "requires": "Every candidate uses each item exactly once."
    },

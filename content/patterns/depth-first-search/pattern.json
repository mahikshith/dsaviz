{
  "schemaVersion": 1,
  "id": "depth-first-search",
  "status": "published",
  "name": "Depth-first search",
  "short": "DF",
  "hue": "violet",
  "family": "graph",
  "order": 20,
  "intuition": "Follow one path as deep as it goes, then back up and try the next, marking what you have already explored.",
  "aliases": [
    "DFS",
    "recursion on trees",
    "flood fill",
    "explore deep",
    "connected components"
  ],
  "topics": [
    "trees",
    "graphs"
  ],
  "prerequisites": [
    "recursion",
    "tree",
    "graph"
  ],
  "variants": [
    {
      "id": "tree",
      "name": "Recursion on trees",
      "summary": "Solve the problem for each child, then combine the answers at the parent.",
      "requires": "The structure has no cycles, so each node is reached once."
    },
    {
      "id": "grid",
      "name": "Flood fill on grids",
      "summary": "From a cell, visit every connected cell of the same kind, marking as you go.",
      "requires": "Neighbours are well defined, and marks prevent revisiting."
    },
    {
      "id": "graph",
      "name": "Walk a whole graph",
      "summary": "Visit each node once, using a visited set to survive cycles.",
      "requires": "You need every reachable node, not shortest distances."
    }
  ],
  "visual": {

    "linked-list",
    "pointer"
  ],
  "variants": [
    {
      "id": "whole-list",
      "name": "Reverse a whole list",
      "summary": "Walk from the head, pointing each node back at the one before it.",
      "requires": "You may change the links of the list."
    },
    {
      "id": "sublist",
      "name": "Reverse part of a list",
      "summary": "Reverse only between two positions, then reconnect the ends.",
      "requires": "You can find the node just before the part, or use a placeholder head."
    }
  ],

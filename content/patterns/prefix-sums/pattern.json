  "family": "sequence",
  "order": 30,
  "intuition": "Write running totals once, then read the total of any range as a single subtraction.",
  "aliases": [
    "running total",
    "cumulative sum",
    "range sum"
  ],
  "topics": [
    "arrays"
  ],
  "prerequisites": [
    "subarray",
    "prefix-sum"
  ],
  "variants": [
    {
      "id": "range-sum",
      "name": "Range totals",
      "summary": "Build running totals once, then answer each range total with one subtraction.",
      "requires": "Values that can be added and subtracted exactly, such as whole numbers."
    },
    {
      "id": "prefix-products",
      "name": "Running products",
      "summary": "Build products from the left and from the right, then combine them at each position.",
      "requires": "The combining operation is exact; products of whole numbers qualify."
    },
    {
      "id": "prefix-counts",
      "name": "Count matching ranges",
      "summary": "Count earlier running totals that differ from the current one by the target, using a map.",
      "requires": "Range totals are differences of running totals, which holds for sums, even with negative values."
    }
  ],

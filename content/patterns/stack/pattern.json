  "name": "Stack",
  "short": "ST",
  "hue": "rose",
  "family": "structure",
  "order": 10,
  "intuition": "When the most recent unfinished item must be handled first, keep pending items on a stack.",
  "aliases": [
    "last in first out",
    "LIFO",
    "matching brackets",
    "nesting"
  ],
  "topics": [
    "stacks-and-queues",
    "strings"
  ],
  "prerequisites": [
    "stack"
  ],
  "variants": [
    {
      "id": "matching",
      "name": "Matching pairs",
      "summary": "Push every opener; each closer must match the opener on top.",
      "requires": "Pairs must nest: whatever opened last must close first."
    },
    {
      "id": "monotonic",
      "name": "Monotonic stack",
      "summary": "Keep the stack in sorted order to find each item's next larger or smaller neighbour.",
      "requires": "Each item needs only its nearest larger (or smaller) neighbour in one direction."
    },
    {
      "id": "design",
      "name": "Stack with extra memory",
      "summary": "Store extra information beside each item, such as the minimum at that moment.",
      "requires": "The extra information depends only on the items below it."
    }
  ],

  "examples": [
    {
      "id": "diary",
      "label": "Four meetings",
      "input": {
        "intervals": [
          [
            1,
            3
          ],
          [
            2,
            6
          ],
          [
            8,
            10
          ],
          [
            15,
            18
          ]
        ]
      },
      "expectedOutput": [
        [
          1,
          6
        ],
        [
          8,
          10
        ],
        [
          15,
          18
        ]
      ],
      "explanation": "1–3 and 2–6 overlap, so they become 1–6."
    },
    {
      "id": "touching",
      "label": "Back to back",
      "input": {
        "intervals": [
          [
            1,
            4
          ],
          [
            4,
            5
          ]
        ]
      },
      "expectedOutput": [
        [
          1,
          5
        ]
      ],
      "explanation": "A meeting starting exactly when another ends is treated as overlapping."
    },
    {
      "id": "unsorted",
      "label": "Out of order",
      "input": {
        "intervals": [
          [
            5,
            7
          ],
          [
            1,
            2
          ]
        ]
      },
      "expectedOutput": [
        [
          1,
          2
        ],
        [
          5,
          7
        ]
      ],
      "explanation": "Sorted by start, nothing overlaps."
    }
  ],
  "ladder": [
    {
      "id": "merge-any-pair",
      "level": "brute-force",
      "name": "Merge any overlapping pair, repeat",
      "idea": "Look for any two meetings that overlap, merge them, and start again until no pair overlaps.",
      "time": "O(n³)",
      "space": "O(n)"
    },
    {
      "id": "sort-and-sweep",
      "level": "optimal",
      "name": "Sort by start, sweep once",
      "idea": "Sort meetings by start. Walk through them: if a meeting starts before the current block ends, stretch the block; otherwise start a new block.",
      "insight": "Once sorted by start, a meeting can only overlap the block just before it, never an earlier one. One pass settles everything.",
      "time": "O(n log n)",
      "space": "O(n)"
    }
  ],

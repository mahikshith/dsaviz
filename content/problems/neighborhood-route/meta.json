  "ladder": [
    {
      "id": "all-routes",
      "level": "brute-force",
      "name": "Try every route",
      "idea": "List every route from home that never revisits a corner, and keep the shortest one that reaches the library.",
      "time": "Exponential",
      "space": "O(V)"
    },
    {
      "id": "bfs",
      "level": "optimal",
      "name": "Breadth-first search",
      "idea": "Explore corners in rings of distance with a queue. The first time the library is discovered, its distance is the fewest streets.",
      "insight": "If corners are reached in order of distance, the first route to the library is a shortest one, so complete routes never need comparing.",
      "time": "O(V + E)",
      "space": "O(V)",
      "approachId": "bfs"
    }
  ],
  "approaches": [

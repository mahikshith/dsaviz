  "transfer": {
    "problem": "In a word game you change one letter at a time and every step must be a real word. Find the fewest steps from COLD to WARM.",
    "answerPatternId": "breadth-first-search",
    "explanation": "Each word is a node and each one-letter change is an edge of equal cost, so the fewest steps is a shortest path in an unweighted graph."
  },
  "practice": {
    "selfCheck": [
      "Records a corner's distance when it joins the queue, so no corner is queued twice.",
      "Uses a queue (first in, first out), not a stack.",
      "Returns no route when the goal cannot be reached.",
      "Returns 0 streets when start and goal are the same corner.",
      "Only promises the shortest route because every street counts the same."
    ]
  },

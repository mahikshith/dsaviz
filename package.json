{
  "name": "pattern-atlas",
  "version": "0.5.0",
  "private": true,
  "description": "Data structures and algorithms taught through short stories, deterministic walkthroughs and pattern-grouped practice.",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run validate && node scripts/next.mjs build",
    "start": "node scripts/serve-out.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "marked": "18.0.14",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "optionalDependencies": {
    "@next/swc-wasm-nodejs": "16.3.8"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.63.6"
  }
}
